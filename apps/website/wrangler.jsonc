{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lyra-website",
  "main": "worker/index.js",
  // Keep runtime behavior stable when updating the build toolchain.
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  // Enables branch previews; assets and compatibility stay at the top level.
  "previews": {},
  "routes": [
    { "pattern": "lyra.eiselabs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker rewrites page metadata; static files can go straight to assets.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/og-image.png"
    ],
    // The existing Worker owns page fallback. /index.html must be fetchable
    // without redirecting /download and other page requests back to /.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
