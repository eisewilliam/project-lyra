{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lyra-website",
  "main": "worker/index.js",
  // Keep runtime behavior stable when updating the build toolchain.
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  // Enables branch previews; assets and compatibility stay at the top level.
  "previews": {},
  "routes": [
    { "pattern": "lyra.eiselabs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker maps page addresses to their prerendered files; static
    // files can go straight to assets.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/og-image.png",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/pages.json"
    ],
    // The Worker owns page routing: /download serves download/index.html,
    // /download/ redirects to /download, and unknown pages get the SPA shell
    // (_shell.html) with a 404 status.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
