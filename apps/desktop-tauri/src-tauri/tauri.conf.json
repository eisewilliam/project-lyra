{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lyra",
  "identifier": "app.lyralyrics.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyra",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 440,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": false,
        "backgroundColor": "#16161a",
        "hiddenTitle": true,
        "visible": false,
        "acceptFirstMouse": true,
        "backgroundThrottling": "throttle"
      },
      {
        "label": "island",
        "title": "Marquee",
        "url": "/island",
        "width": 400,
        "height": 48,
        "y": 0,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "hiddenTitle": true,
        "visible": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "settings",
        "title": "Lyra — Settings",
        "url": "/settings",
        "width": 860,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "acceptFirstMouse": true,
        "hiddenTitle": true,
        "visible": false,
        "backgroundThrottling": "suspend"
      },
      {
        "label": "karaoke",
        "title": "Karaoke",
        "url": "/karaoke",
        "width": 1440,
        "height": 180,
        "x": 0,
        "y": 0,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "focus": false,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 Olusegun William Eise. MIT License.",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.2.0.1"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMEE3NDM3OUYwRDRGMjkKUldRcFR3MmZOM1FLZ2diamJQdEQ5bEpDdnJiTU9uRUZoSlA1dmtYMDFWWFZmWHZyTmY4ekxMSXcK",
      "endpoints": [
        "https://github.com/eisewilliam/project-lyra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
